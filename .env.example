# Protei Security Suite - Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DB_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=protei_security
POSTGRES_USER=protei

# Security
JWT_SECRET=your_very_long_and_random_jwt_secret_here_minimum_32_characters
SCANNER_API_KEY=your_scanner_api_key_here

# Central Manager
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8443

# Redis (optional, for caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

# Email Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@protei-security.local

# Webhook URL for SIEM integration (optional)
WEBHOOK_URL=

# CVE Feed Configuration
NVD_API_KEY=

# IP Reputation Services (optional)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# License (for enterprise features)
LICENSE_KEY=
