# Linux Agent Dockerfile
FROM golang:1.21 AS builder

WORKDIR /app

COPY go.mod ./
COPY go.sum* ./
RUN go mod download || go mod tidy

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-s -w" -o protei-agent-linux ./cmd/agent-linux

FROM debian:bookworm-slim

# Install security tools
RUN apt-get update && apt-get install -y \
    clamav \
    clamav-daemon \
    chkrootkit \
    rkhunter \
    iproute2 \
    net-tools \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Update ClamAV database
RUN freshclam || true

WORKDIR /app

COPY --from=builder /app/protei-agent-linux .

# Create config directory
RUN mkdir -p /etc/protei

CMD ["./protei-agent-linux"]
