# Multi-stage build for Network Scanner
FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git make

WORKDIR /app

COPY go.mod ./
COPY go.sum* ./
RUN go mod download || go mod tidy

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-s -w" -o protei-scanner ./cmd/scanner

FROM alpine:latest

RUN apk --no-cache add ca-certificates nmap

WORKDIR /app

COPY --from=builder /app/protei-scanner .

CMD ["./protei-scanner"]
